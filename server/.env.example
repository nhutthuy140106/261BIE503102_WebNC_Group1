PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/DoAnWeb
SESSION_SECRET=doi-chuoi-bi-mat-nay
CLIENT_ORIGIN=http://localhost:4200
NODE_ENV=development
# Mật khẩu dùng cho tài khoản mẫu khi chạy `npm run seed` (không viết cứng trong repo)
SEED_PASSWORD=
# Chatbot tư vấn dùng Google Gemini (có gói miễn phí). Lấy khóa ở https://aistudio.google.com ; để trống thì chatbot dùng bộ trả lời cơ bản
GEMINI_API_KEY=
# Model Gemini (mặc định gemini-3.8-flash; các bản 2.5 đã ngừng cho tài khoản mới)
GEMINI_MODEL=gemini-3.8-flash
# Nhà cung cấp khác theo chuẩn OpenAI (Groq, OpenRouter, Mistral…). Ví dụ Groq: lấy khóa ở https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Hết hạn mức token/phút ở model chính thì thử lần lượt các model này (mỗi model có hạn mức riêng)
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Chế độ chatbot: auto (Gemini → LLM → bộ cơ bản, bước nào có khóa và chạy được thì dùng) | gemini | llm | local
ASSISTANT_MODE=auto
