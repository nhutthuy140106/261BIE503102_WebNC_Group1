### ===== Đơn đã đặt =====
POST {{base}}/orders
Content-Type: application/json

{
  "postId": "{{id}}",
  "quantity": 2,
  "selections": [{ "group": "Món mặn", "choices": ["Sườn rim"] }],
  "answers": [],
  "fulfillment": "pickup",
  "utensils": true,
  "note": "Ít cay",
  "voucherCode": "XU10",
  "payment": "cash"
}

###
GET {{base}}/orders?role=placed&state=active

###
GET {{base}}/orders/{{id}}

###
